# Copier ce fichier en .env.local puis renseigner les valeurs ci-dessous.
# .env.local n'est jamais commité (voir .gitignore) — chacun garde ses propres clés.

# --- Supabase ---
# Dashboard Supabase du projet -> Project Settings -> API
# URL du projet Supabase (publique, visible côté client).
NEXT_PUBLIC_SUPABASE_URL=
# Clé publique "anon" (publique, protégée par les règles RLS côté Supabase).
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# --- Stripe ---
# Dashboard Stripe -> Developers -> API keys
# Clé secrète, utilisée uniquement côté serveur (lib/stripe.ts). Ne jamais
# l'exposer côté client ni la préfixer par NEXT_PUBLIC_.
STRIPE_SECRET_KEY=
# Clé publique, utilisée côté client pour @stripe/stripe-js (lib/stripe-client.ts).
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
